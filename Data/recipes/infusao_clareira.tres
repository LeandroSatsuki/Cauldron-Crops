[gd_resource type="Resource" script_class="RecipeData" load_steps=2 format=3]

[ext_resource type="Script" path="res://Scripts/data/RecipeData.gd" id="1_recipe"]

[resource]
script = ExtResource("1_recipe")
id = "infusao_clareira"
nome = "Infusão da Clareira"
descricao = "Aprendida ao restaurar a clareira. Carvão + Mistura Restauradora produzem Poção de Crescimento: use a poção no Caderno da Fazenda e clique em culturas crescendo, sem ferramenta ativa. Cada aplicação reduz pela metade o tempo restante."
categoria = "pocao"
ingredientes = Array[String](["carvao", "mistura_restauradora"])
resultado_item = "pocao_crescimento"
resultado_quantidade = 1
tempo_producao = 4.0
exige_descoberta = true
recompensa_pontos_alquimia = 0
tags = Array[String](["bosque", "crescimento", "restauracao"])
